---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PromptCard from '../components/PromptCard.astro';
import Badge from '../components/Badge.astro';
import Navigation from '../components/Navigation.astro';
import HeroGallery from '../components/HeroGallery.astro';

// Content Data could be moved to content collections later, but for now we inline it as requested
---

<MainLayout 
  title="Нейрофотосессия: Полный гайд 2025 | Nano Banana AI" 
  description="Превратите обычное селфи в профессиональное фото за 30 секунд. 100 готовых промтов."
>
  <div slot="header-actions">
     <a href="https://t.me/nanobananas_bot" target="_blank" class="inline-flex items-center justify-center gap-2 rounded-lg text-sm font-semibold transition-all bg-primary text-primary-foreground hover:bg-primary/90 px-4 py-2 border-2 border-primary/50 hover:border-primary shadow-sm hover:shadow-md">
       <span>🤖</span>
       <span>Открыть бота</span>
     </a>
  </div>

  <div slot="sidebar">
    <Navigation />
  </div>

  <!-- INTRO SECTION -->
  <section id="intro" class="scroll-mt-24 mb-16 space-y-6">
    <div class="max-w-5xl mx-auto w-full">
      <div class="space-y-4 max-w-4xl mb-4">
        <h1 class="text-4xl font-extrabold tracking-tight lg:text-5xl animate-in fade-in slide-in-from-bottom-4 duration-1000">
          Нейрофотосессия: Полный гайд
        </h1>
        <p class="text-xl text-muted-foreground leading-relaxed">
          Превратите обычное селфи в профессиональную фотосессию за 30 секунд. 
          Экономьте тысячи рублей на фотографах.
        </p>
      </div>

      <HeroGallery />

      <!-- Welcome Introduction -->
      <div class="bg-gradient-to-br from-primary/5 via-card to-accent/5 border-2 border-primary/20 rounded-2xl p-8 mt-8 mb-8">
        <h2 class="text-2xl font-bold mb-4 flex items-center gap-3">
          <span class="text-3xl">🍌</span>
          <span>Добро пожаловать в гайд по нейрофотографии!</span>
        </h2>
        
        <p class="text-lg text-muted-foreground mb-6">
          Это не просто инструкция к боту — это ваш билет в новую профессию, которая набирает обороты прямо сейчас.
        </p>

        <div class="bg-card/50 rounded-xl p-6 border border-border">
          <h3 class="font-bold mb-4 flex items-center gap-2">
            <span>📊</span>
            <span>Что вас ждёт:</span>
          </h3>
          
          <div class="space-y-3 text-sm">
            <div class="flex gap-3">
              <span class="font-bold text-primary shrink-0">Раздел 1:</span>
              <div>
                <div class="font-semibold">Нейрофотография как профессия</div>
                <div class="text-muted-foreground">→ Что это, кто платит, сколько можно зарабатывать</div>
              </div>
            </div>
            
            <div class="flex gap-3">
              <span class="font-bold text-primary shrink-0">Раздел 2:</span>
              <div>
                <div class="font-semibold">Изучаем инструмент</div>
                <div class="text-muted-foreground">→ Возможности @nanobananas_bot — ваш рабочий инструмент</div>
              </div>
            </div>
            
            <div class="flex gap-3">
              <span class="font-bold text-primary shrink-0">Раздел 3:</span>
              <div>
                <div class="font-semibold">Правила создания качественных фото</div>
                <div class="text-muted-foreground">→ Секреты промптов с 96%+ сохранением лица</div>
              </div>
            </div>
            
            <div class="flex gap-3">
              <span class="font-bold text-primary shrink-0">Раздел 4:</span>
              <div>
                <div class="font-semibold">Как найти первых клиентов</div>
                <div class="text-muted-foreground">→ От портфолио до денег на Авито</div>
              </div>
            </div>
            
            <div class="flex gap-3">
              <span class="font-bold text-primary shrink-0">Раздел 5:</span>
              <div>
                <div class="font-semibold">Библиотека готовых промтов</div>
                <div class="text-muted-foreground">→ 250+ решений для работы</div>
              </div>
            </div>
          </div>
        </div>

        <p class="text-lg font-bold mt-6 text-center">
          Поехали! 🚀
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 mt-4">
        <!-- Card 1: Price -->
        <div class="group relative overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-green-500/10 via-card to-card p-6 shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 hover:border-green-500/50">
          <div class="absolute inset-0 bg-gradient-to-br from-green-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div class="text-4xl">💸</div>
              <div class="text-xs font-semibold text-green-500 bg-green-500/10 px-2 py-1 rounded-full">Экономия</div>
            </div>
            <div class="text-xl font-extrabold mb-2 bg-gradient-to-r from-green-400 to-emerald-600 bg-clip-text text-transparent leading-tight">Экономия</div>
            <div class="text-sm text-muted-foreground font-medium">Сэкономьте деньги на фотосессиях и создании контента</div>
          </div>
        </div>

        <!-- Card 2: Speed -->
        <div class="group relative overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-blue-500/10 via-card to-card p-6 shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 hover:border-blue-500/50">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div class="text-4xl">⚡</div>
              <div class="text-xs font-semibold text-blue-500 bg-blue-500/10 px-2 py-1 rounded-full">Скорость</div>
            </div>
            <div class="text-xl font-extrabold mb-2 bg-gradient-to-r from-blue-400 to-cyan-600 bg-clip-text text-transparent leading-tight">Быстро</div>
            <div class="text-sm text-muted-foreground font-medium">Создавайте контент за 30 секунд вместо часов съемки</div>
          </div>
        </div>

        <!-- Card 3: Location -->
        <div class="group relative overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-purple-500/10 via-card to-card p-6 shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 hover:border-purple-500/50">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div class="text-4xl">🌍</div>
              <div class="text-xs font-semibold text-purple-500 bg-purple-500/10 px-2 py-1 rounded-full">Свобода</div>
            </div>
            <div class="text-xl font-extrabold mb-2 bg-gradient-to-r from-purple-400 to-pink-600 bg-clip-text text-transparent leading-tight">Везде</div>
            <div class="text-sm text-muted-foreground font-medium">Окажитесь в любой локации планеты сидя дома</div>
          </div>
        </div>

        <!-- Card 4: Face Preservation -->
        <div class="group relative overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-primary/10 via-card to-card p-6 shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 hover:border-primary/50">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between mb-3">
              <div class="text-4xl">👤</div>
              <div class="text-xs font-semibold text-primary bg-primary/10 px-2 py-1 rounded-full">Точность</div>
            </div>
            <div class="text-xl font-extrabold mb-2 bg-gradient-to-r from-yellow-400 to-orange-600 bg-clip-text text-transparent leading-tight">Сходство 96%</div>
            <div class="text-sm text-muted-foreground font-medium">Максимальное сохранение черт</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROFESSION SECTION -->
  <SectionHeader id="profession" title="💼 Нейрофотограф — новая профессия 2026 года" className="pt-4 md:pt-8">
    <!-- Intro text -->
    <div class="bg-gradient-to-br from-purple-500/5 to-blue-500/5 border-2 border-purple-500/20 rounded-xl p-6 mb-8">
      <p class="text-lg text-muted-foreground leading-relaxed mb-4">
        Пока одни спорят, заменит ли ИИ фотографов, другие уже зарабатывают на нейрофотографии. 
        Это не будущее — это настоящее. И вы можете начать прямо сейчас.
      </p>
      <p class="text-lg font-semibold text-foreground">
        В этом разделе вы узнаете, кто такой нейрофотограф, почему это востребовано, кто ваши клиенты и сколько можно зарабатывать.
      </p>
    </div>

    <div class="space-y-8">
      <!-- What is it -->
      <div class="bg-card border rounded-xl p-6">
        <h3 class="text-xl font-bold mb-4">Что это такое?</h3>
        <p class="text-muted-foreground leading-relaxed mb-4">
          <strong>Нейрофотограф</strong> — специалист, который создаёт профессиональные фото с помощью ИИ. 
          Это не фотошопер и не дизайнер. Это отдельная профессия на стыке технологий и визуала.
        </p>
        <p class="text-muted-foreground leading-relaxed">
          Вы берёте фото клиента и с помощью нейросетей создаёте новые изображения: меняете фон, одежду, локацию, 
          добавляете эффекты — при этом лицо человека сохраняется на 96-98%. Результат выглядит как профессиональная фотосессия, 
          но создаётся за 10-30 минут вместо нескольких часов съёмки.
        </p>
      </div>

      <!-- Why востребовано -->
      <div class="bg-card border rounded-xl p-6">
        <h3 class="text-xl font-bold mb-4">Почему это востребовано?</h3>
        <p class="font-semibold mb-3">Цифры из исследований:</p>
        <ul class="space-y-2 text-muted-foreground">
          <li class="flex items-start gap-2">
            <span class="text-primary font-bold">•</span>
            <span>Рост поисковых запросов "нейрофотосессия" в 4 раза за 2025 год (данные VC.ru)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary font-bold">•</span>
            <span>Средняя цена: 150-500₽ за фото, 3000-7000₽ за пакет</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-primary font-bold">•</span>
            <span>Рынок в фазе активного роста</span>
          </li>
        </ul>
      </div>

      <!-- Clients -->
      <div class="bg-card border rounded-xl p-6">
        <h3 class="text-xl font-bold mb-4">Кто ваши клиенты?</h3>
        <p class="text-muted-foreground mb-6">Рынок нейрофотографии очень широкий. Вот 5 основных типов клиентов, с которыми вы будете работать:</p>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="bg-muted/30 p-5 rounded-lg">
            <h4 class="font-bold mb-3 text-lg">1. Блогеры и инфлюенсеры</h4>
            <p class="text-sm text-muted-foreground mb-3">Им нужен постоянный контент для TikTok, VK, Telegram. Подложки для сторис, обложки постов, фото для рилсов.</p>
            <div class="bg-card/50 p-3 rounded-lg mb-3">
              <p class="text-xs font-semibold mb-2">Что они заказывают:</p>
              <ul class="text-xs text-muted-foreground space-y-1">
                <li>• 10-20 фото в месяц в разных образах</li>
                <li>• Тематические серии (Новый год, лето, осень)</li>
                <li>• Фото с трендовыми локациями</li>
              </ul>
            </div>
            <p class="text-sm font-semibold text-primary">Готовы платить: 3000-5000₽/месяц</p>
            <p class="text-xs text-muted-foreground mt-2">Часто становятся постоянными клиентами на 3-6 месяцев</p>
          </div>

          <div class="bg-muted/30 p-5 rounded-lg">
            <h4 class="font-bold mb-3 text-lg">2. Владельцы магазинов на WB и Ozon</h4>
            <p class="text-sm text-muted-foreground mb-3">Им нужны карточки товаров с разными моделями. Реальная фотосессия стоит 15-30 тысяч и занимает неделю. Нейрофото — 3-5 тысяч за день.</p>
            <div class="bg-card/50 p-3 rounded-lg mb-3">
              <p class="text-xs font-semibold mb-2">Что они заказывают:</p>
              <ul class="text-xs text-muted-foreground space-y-1">
                <li>• Одежду на разных моделях (разный возраст, типаж)</li>
                <li>• Товары в интерьере (посуда, декор)</li>
                <li>• Аксессуары на моделях</li>
              </ul>
            </div>
            <p class="text-sm font-semibold text-primary">Готовы платить: 5000-10000₽ за серию</p>
            <p class="text-xs text-muted-foreground mt-2">Большие заказы, но требуют качества и правок</p>
          </div>

          <div class="bg-muted/30 p-5 rounded-lg">
            <h4 class="font-bold mb-3 text-lg">3. Фрилансеры и специалисты</h4>
            <p class="text-sm text-muted-foreground mb-3">Им нужны фото для резюме на HeadHunter, Habr Career, LinkedIn, портфолио на Behance.</p>
            <div class="bg-card/50 p-3 rounded-lg mb-3">
              <p class="text-xs font-semibold mb-2">Что они заказывают:</p>
              <ul class="text-xs text-muted-foreground space-y-1">
                <li>• Деловые портреты в офисе/коворкинге</li>
                <li>• Фото в повседневном стиле для соцсетей</li>
                <li>• Креативные портреты для творческих профессий</li>
              </ul>
            </div>
            <p class="text-sm font-semibold text-primary">Готовы платить: 500-1500₽ за 3-5 портретов</p>
            <p class="text-xs text-muted-foreground mt-2">Самая массовая аудитория, легко найти</p>
          </div>

          <div class="bg-muted/30 p-5 rounded-lg">
            <h4 class="font-bold mb-3 text-lg">4. Владельцы малого бизнеса</h4>
            <p class="text-sm text-muted-foreground mb-3">Им нужны фото команды для сайта. Корпоративная съёмка стоит 50-80 тысяч. Вы делаете за 10-25 тысяч.</p>
            <div class="bg-card/50 p-3 rounded-lg mb-3">
              <p class="text-xs font-semibold mb-2">Что они заказывают:</p>
              <ul class="text-xs text-muted-foreground space-y-1">
                <li>• Портреты сотрудников в едином стиле</li>
                <li>• Фото команды для раздела "О нас"</li>
                <li>• Фото руководителей для пресс-релизов</li>
              </ul>
            </div>
            <p class="text-sm font-semibold text-primary">Готовы платить: 10000-25000₽ за 5-15 человек</p>
            <p class="text-xs text-muted-foreground mt-2">Крупные заказы, но найти сложнее</p>
          </div>

          <div class="bg-muted/30 p-5 rounded-lg">
            <h4 class="font-bold mb-3 text-lg">5. Обычные люди</h4>
            <p class="text-sm text-muted-foreground mb-3">Им нужны красивые аватарки для соцсетей, подарочные фото, примерка образов перед покупкой одежды.</p>
            <div class="bg-card/50 p-3 rounded-lg mb-3">
              <p class="text-xs font-semibold mb-2">Что они заказывают:</p>
              <ul class="text-xs text-muted-foreground space-y-1">
                <li>• Фото в разных образах и локациях</li>
                <li>• Подарочные фотосессии (день рождения, годовщина)</li>
                <li>• Фото "как я бы выглядел в Париже/на пляже"</li>
              </ul>
            </div>
            <p class="text-sm font-semibold text-primary">Готовы платить: 300-1000₽ за 5-10 фото</p>
            <p class="text-xs text-muted-foreground mt-2">Самые простые заказы, идеально для старта</p>
          </div>
        </div>
      </div>

      <!-- Real examples -->
      <div class="bg-gradient-to-br from-blue-500/5 to-purple-500/5 border-2 border-blue-500/20 rounded-xl p-6">
        <h3 class="text-xl font-bold mb-4">Реальные примеры с Авито и Яндекс.Услуг:</h3>
        <div class="bg-card/50 p-4 rounded-lg mb-4">
          <p class="text-sm text-muted-foreground mb-2">Средние цены (декабрь 2025):</p>
          <ul class="space-y-1 text-sm">
            <li class="flex items-center gap-2">
              <span class="text-primary font-bold">•</span>
              <span>1 фото: 150-500₽</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-primary font-bold">•</span>
              <span>5 фото: 990-1500₽</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-primary font-bold">•</span>
              <span>10 фото: 3000-5000₽</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-primary font-bold">•</span>
              <span>20-30 фото: 5000-7000₽</span>
            </li>
          </ul>
        </div>
        <div class="space-y-2 text-sm">
          <p class="font-semibold">Примеры объявлений:</p>
          <ul class="space-y-2 text-muted-foreground">
            <li class="flex items-start gap-2">
              <span class="text-primary">→</span>
              <span>"10 фото — 3000₽, Стандарт / 5000₽ Расширенный" (47 исполнителей в Москве)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary">→</span>
              <span>"Нейрофотосессия от 490₽, первые 3 превью бесплатно"</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary">→</span>
              <span>"AI-фотосессия — готово за день, любая локация"</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Advantages -->
      <div class="bg-card border rounded-xl p-6">
        <h3 class="text-xl font-bold mb-4">Ваши преимущества:</h3>
        <div class="grid gap-3 md:grid-cols-2">
          <div class="flex items-start gap-3">
            <span class="text-2xl">✅</span>
            <div>
              <p class="font-semibold">Нулевые вложения</p>
              <p class="text-sm text-muted-foreground">Не нужна камера, студия</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl">✅</span>
            <div>
              <p class="font-semibold">Работа из дома</p>
              <p class="text-sm text-muted-foreground">Клиенты по всей России</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl">✅</span>
            <div>
              <p class="font-semibold">Быстрый старт</p>
              <p class="text-sm text-muted-foreground">Первый заказ можно получить через несколько дней</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl">✅</span>
            <div>
              <p class="font-semibold">Экологичная профессия</p>
              <p class="text-sm text-muted-foreground">Помогаете людям выглядеть лучше</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-2xl">✅</span>
            <div>
              <p class="font-semibold">Масштабируемость</p>
              <p class="text-sm text-muted-foreground">От подработки до основного дохода</p>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center">
        <p class="text-lg font-semibold">Готовы попробовать? Читайте дальше 👇</p>
      </div>
    </div>
  </SectionHeader>

  <!-- CASES SECTION -->
  <SectionHeader id="cases" title="🎯 Зачем вам нейрофотосессия?" className="pt-4 md:pt-8">
    <div class="bg-gradient-to-r from-primary/10 to-accent/10 border border-primary/20 rounded-xl p-6 mb-8">
      <p class="text-lg text-muted-foreground leading-relaxed">
        Перед техническими деталями — разберёмся в реальных ситуациях.
        <br/>
        Вот 6 практических кейсов, которые вы будете решать для клиентов (или для себя).
      </p>
    </div>
    
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-6">
      <div class="rounded-xl border bg-card p-6 shadow-sm">
        <Badge variant="secondary" class="mb-2">Кейс #1 💼</Badge>
        <h3 class="text-lg font-bold mb-2">Обновить фото для резюме</h3>
        <p class="text-muted-foreground text-sm">Старое фото не внушает доверия? Сделайте профессиональный деловой портрет в костюме за 1 минуту.</p>
